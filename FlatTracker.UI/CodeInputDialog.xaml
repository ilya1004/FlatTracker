<Window x:Class="FlatTracker.UI.CodeInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация Telegram"
        SizeToContent="Height"
        Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,12" />
        <PasswordBox x:Name="ValueBox" Margin="0,0,0,16" MinHeight="26" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Padding="14,6" Margin="0,0,8,0" IsCancel="True" Click="OnCancel" />
            <Button Content="ОК" Padding="14,6" IsDefault="True" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
